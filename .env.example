# Or enable "Allow EmailJS API for non-browser applications" under Account → Security.
# EMAILJS_PRIVATE_KEY=
# Comma-separated admin emails allowed to use /admin and privileged APIs.
# Example: STAFF_EMAILS=you@laycfactory.com,ops@laycfactory.com
STAFF_EMAILS=
